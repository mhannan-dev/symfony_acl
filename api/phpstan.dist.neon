parameters:
    level: 6
    paths:
        - bin
        - config
        - public
        - src
        - tests
    scanFiles:
        - config/bundles.php
    symfony:
        container_xml_path: '%rootDir%/../../var/cache/dev/App_KernelDevDebugContainer.xml'
    doctrine:
        objectManagerLoader: tests/object-manager.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        - '#MissingType.generics#'
    excludePaths:
        - config/bundles.php
        - tests/object-manager.php
